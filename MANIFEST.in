# The sdist is meant to be a self-contained copy of the project: the package,
# its full test suite, the runnable examples, and the documentation sources, so
# a downstream packager can build and validate the release without a checkout.

include CHANGELOG.md
# Local benchmark output is not part of a source release, including when an
# older egg-info/SOURCES.txt still lists previous measurements.
prune benchmarks
include CODE_OF_CONDUCT.md
include CONTRIBUTING.md
include SECURITY.md
include SUPPORT.md
include mkdocs.yml

recursive-include tests *.py
recursive-include examples *.py
recursive-include docs *.md
recursive-include docs *.css
recursive-include tools *.py

# The C array core and numerical accelerators are required; a source
# distribution must contain every C implementation and shared header.
include setup.py
recursive-include csrc *.c
recursive-include csrc *.h

# Remove obsolete sources even from cached egg-info/SOURCES.txt manifests.
prune rust

# Generated figures and their manifest are omitted from the source archive.
# `python tools/gen_figures.py` regenerates both from the included tools and
# package sources before a complete documentation-site build.
recursive-exclude docs/assets/figures *

# A compiled backend left in the working tree by a previous build must never
# reach the sdist: it is one platform's binary, and shipping it would hand every
# other platform an extension it cannot load. Wheels get only the C extension
# produced by the current build_ext command.
recursive-exclude quadrivium *.so *.pyd *.dylib *.dll

# Never ship build, cache, or editor droppings.
global-exclude *.py[cod]
global-exclude .DS_Store
prune .github
prune .pytest_cache
prune **/__pycache__
